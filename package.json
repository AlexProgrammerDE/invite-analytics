{
  "name": "invite-analytics",
  "version": "1.0.0",
  "description": "Discord invite tracking and analytics bot",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --dts",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "fix": "biome check --write --unsafe",
    "check": "biome check",
    "deploy-commands": "tsx src/commands/index.ts"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "discord.js": "^14.18.0",
    "dotenv": "^17.2.4",
    "drizzle-orm": "^0.39.0",
    "ioredis": "^5.6.0",
    "pino": "^10.0.0",
    "postgres": "^3.4.5",
    "react": "^19.2.4",
    "satori": "^0.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/node": "^22.13.0",
    "@types/react": "^19.2.13",
    "drizzle-kit": "^0.30.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
